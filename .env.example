# Optional — only needed if you deploy the worker/ backend and want every
# visitor to use it without configuring their own keys.
#
# When VITE_BACKEND_URL is set at build time, the frontend automatically
# routes all AI / image / URL-fetch calls through your Cloudflare Worker.

# VITE_BACKEND_URL=https://hongxin-backend.your-subdomain.workers.dev

# Optional shared secret. Must match ACCESS_TOKEN set on the Worker.
# Adds an X-Access-Token header to all backend requests (light protection).
# VITE_BACKEND_TOKEN=some-long-random-string
